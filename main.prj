<deployment-project plugin="plugin.ezdeploy" plugin-version="1.0">
  <configuration build-checksum="996319427" file="C:\Users\karol\Documents\MATLAB\SeismicSignalAnalyzer\main.prj" location="C:\Users\karol\Documents\MATLAB\SeismicSignalAnalyzer" name="main" preferred-package-location="C:\Users\karol\Documents\MATLAB\SeismicSignalAnalyzer\main\for_redistribution" preferred-package-type="package.type.exe" target="target.ezdeploy.standalone" target-name="Application Compiler">
